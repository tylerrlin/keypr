# USB - must be OTG (native USB), not JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USB_OTG_SUPPORTED=y

# TinyUSB
CONFIG_TINYUSB=y
CONFIG_TINYUSB_HID_ENABLED=y
CONFIG_TINYUSB_HID_BUFSIZE=64
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=n
# Custom VID/PID - use your own for production, this is fine for hackathon
CONFIG_TINYUSB_DESC_CUSTOM_VID=0x1209
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x0001
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="HackAuth"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="ESP32S3 FIDO2 Key"
CONFIG_TINYUSB_DESC_SERIAL_STRING="000001"

# BLE - for proximity context check
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# NVS encryption optional but good practice
CONFIG_NVS_ENCRYPTION=n

# mbedTLS - make sure ECC is enabled
CONFIG_MBEDTLS_ECP_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECDSA_ENABLED=y
CONFIG_MBEDTLS_SHA256_ENABLED=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_NIMBLE_TASK_STACK_SIZE=4096
